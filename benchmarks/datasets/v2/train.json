{
  "dataset_version": "sentinel-sre-v2",
  "scenarios": [
    {
      "alert": {
        "alertname": "CheckoutHighErrorRate",
        "description": "Error rate exceeded 10%. Likely a bad deploy or downstream failure.",
        "service": "checkout-service",
        "severity": "critical",
        "summary": "67.5% error rate on checkout-service in the last 5 minutes"
      },
      "allowed_action_types": [
        "rollback",
        "revert_commit",
        "restart"
      ],
      "expected_evidence": [
        "checkout-service error ratio rises above its 0.35 inventory-hold baseline",
        "failing requests carry payment-gateway reasons rather than inventory_hold_unavailable",
        "deployment or release evidence identifies the checkout-service change",
        "the error ratio returns to its 0.35 baseline after remediation"
      ],
      "expected_severity_bands": [
        "SEV1",
        "SEV2"
      ],
      "fault": {
        "adapter": "meridian_admin_config_v1",
        "contracts": [
          {
            "cleanup": {
              "path": "/admin/config",
              "payload": {
                "error_rate": 0.0
              }
            },
            "inject": {
              "path": "/admin/config",
              "payload": {
                "error_rate": 0.5
              }
            },
            "target": "checkout-service"
          }
        ]
      },
      "forbidden_action_types": [
        "scale"
      ],
      "id": "bad_deploy_checkout",
      "provenance": {
        "kind": "executable_reference_workload",
        "reference": "services/checkout-service/app.py (process_checkout); error_rate knob",
        "source": "meridian-shop reference workload"
      },
      "recovery_probe": {
        "name": "checkout_error_ratio",
        "operator": "lt",
        "query": "sum(rate(http_errors_total{service=\"checkout-service\"}[5m])) / clamp_min(sum(rate(http_requests_total{service=\"checkout-service\"}[5m])), 1)",
        "require_failure_observation": true,
        "required_consecutive_passes": 2,
        "threshold": 0.45,
        "unit": "error ratio"
      },
      "risk_class": "critical",
      "root_cause": {
        "keywords": [
          "deploy",
          "commit",
          "rollback",
          "regression",
          "error rate",
          "release"
        ],
        "service": "checkout-service"
      },
      "taxonomy": {
        "category": "deployment",
        "fault_mode": "bad_deploy"
      },
      "version": "2.0.0"
    },
    {
      "alert": {
        "alertname": "CheckoutHighLatency",
        "description": "Latency spike. Slow downstream service or database contention.",
        "service": "checkout-service",
        "severity": "warning",
        "summary": "P95 latency 3.4s on checkout-service, breaching the 1.5s rule"
      },
      "allowed_action_types": [
        "restart",
        "scale",
        "rollback"
      ],
      "expected_evidence": [
        "checkout-service p95 latency exceeds the 1.5s rule threshold",
        "the checkout error ratio is unchanged, so this is latency and not failure",
        "dependency and saturation evidence distinguishes the latency cause",
        "checkout-service p95 latency returns below 1.5 seconds"
      ],
      "expected_severity_bands": [
        "SEV2",
        "SEV3"
      ],
      "fault": {
        "adapter": "meridian_admin_config_v1",
        "contracts": [
          {
            "cleanup": {
              "path": "/admin/config",
              "payload": {
                "slow_rate": 0.0
              }
            },
            "inject": {
              "path": "/admin/config",
              "payload": {
                "slow_rate": 1.0
              }
            },
            "target": "checkout-service"
          }
        ]
      },
      "forbidden_action_types": [],
      "id": "checkout_high_latency",
      "provenance": {
        "kind": "executable_reference_workload",
        "reference": "services/checkout-service/app.py (process_checkout); slow_rate knob",
        "source": "meridian-shop reference workload"
      },
      "recovery_probe": {
        "name": "checkout_p95_latency",
        "operator": "lt",
        "query": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{service=\"checkout-service\"}[5m])))",
        "require_failure_observation": true,
        "required_consecutive_passes": 2,
        "threshold": 1.5,
        "unit": "seconds"
      },
      "risk_class": "high",
      "root_cause": {
        "keywords": [
          "latency",
          "slow",
          "downstream",
          "database",
          "contention",
          "p95"
        ],
        "service": "checkout-service"
      },
      "taxonomy": {
        "category": "ambiguous",
        "fault_mode": "latency"
      },
      "version": "2.0.0"
    },
