      "provenance": {
        "kind": "executable_reference_workload",
        "reference": "services/payment-service/app.py (charge); slow_rate knob surfacing as a checkout alert",
        "source": "meridian-shop reference workload"
      },
      "recovery_probe": {
        "name": "payment_p95_latency",
        "operator": "lt",
