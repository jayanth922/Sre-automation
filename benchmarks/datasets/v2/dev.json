        "payment-service charge latency returns below 1 second"
      ],
      "expected_severity_bands": [
        "SEV2",
        "SEV3"
      ],
      "fault": {
        "adapter": "meridian_admin_config_v1",
        "contracts": [
          {
            "cleanup": {
              "path": "/admin/config",
              "payload": {
                "slow_rate": 0.0
              }
            },
            "inject": {
              "path": "/admin/config",
              "payload": {
                "slow_rate": 0.7
              }
            },
            "target": "payment-service"
          }
        ]
      },
      "forbidden_action_types": [
        "rollback",
        "revert_commit"
      ],
