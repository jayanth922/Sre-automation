{
  "dataset_version": "sentinel-sre-v2",
  "scenarios": [
    {
      "alert": {
        "alertname": "InventorySlowQueries",
        "description": "Slow queries. Missing index, table lock, or high load.",
        "service": "inventory-service",
        "severity": "warning",
        "summary": "90th percentile query latency 2.1s on inventory-service"
      },
      "allowed_action_types": [
        "restart",
        "patch",
        "config_change"
      ],
      "expected_evidence": [
        "p90 db_query_duration_seconds exceeds the 1.0s rule threshold",
        "query, lock, index, or load evidence supports the diagnosed cause",
        "inventory-service error ratio is unchanged, so this is latency and not failure",
        "p90 query latency returns below 1.0 second"
      ],
      "expected_severity_bands": [
        "SEV2",
        "SEV3",
        "SEV4"
      ],
      "fault": {
        "adapter": "meridian_admin_config_v1",
        "contracts": [
          {
            "cleanup": {
              "path": "/admin/config",
              "payload": {
                "slow_query_rate": 0.0
              }
            },
            "inject": {
              "path": "/admin/config",
              "payload": {
                "slow_query_rate": 1.0
              }
            },
            "target": "inventory-service"
          }
        ]
      },
      "forbidden_action_types": [],
      "id": "inventory_slow_queries",
      "provenance": {
        "kind": "executable_reference_workload",
        "reference": "services/inventory-service/app.py (simulate_db_query); slow_query_rate knob",
        "source": "meridian-shop reference workload"
      },
      "recovery_probe": {
        "name": "inventory_db_p90_latency",
        "operator": "lt",
        "query": "histogram_quantile(0.90, sum by (le) (rate(db_query_duration_seconds_bucket{job=\"inventory-service\"}[5m])))",
        "require_failure_observation": true,
        "required_consecutive_passes": 2,
        "threshold": 1.0,
        "unit": "seconds"
      },
      "risk_class": "medium",
      "root_cause": {
        "keywords": [
          "query",
          "queries",
          "index",
          "database",
          "slow",
          "lock"
        ],
        "service": "inventory-service"
      },
      "taxonomy": {
        "category": "configuration",
        "fault_mode": "slow_query"
      },
      "version": "2.0.0"
    },
    {
      "alert": {
        "alertname": "CheckoutHighErrorRate",
        "description": "Error rate exceeded 10%. Likely a bad deploy or downstream failure.",
        "service": "checkout-service",
        "severity": "critical",
        "summary": "67.5% error rate on checkout-service in the last 5 minutes"
      },
      "allowed_action_types": [
        "restart",
        "config_change",
        "escalate"
      ],
      "expected_evidence": [
        "checkout error reasons are db_connection_refused, db_timeout and db_pool_exhausted",
        "the reasons are database-side, not the gateway reasons a bad release produces",
        "payment-service is healthy, so the dependency is not the cause",
        "the checkout error ratio returns to its 0.35 baseline"
      ],
      "expected_severity_bands": [
        "SEV1",
        "SEV2"
      ],
      "fault": {
        "adapter": "meridian_admin_config_v1",
        "contracts": [
          {
            "cleanup": {
              "path": "/admin/config",
              "payload": {
                "chaos_mode": false
              }
            },
            "inject": {
              "path": "/admin/config",
              "payload": {
                "chaos_mode": true
              }
            },
            "target": "checkout-service"
          }
        ]
      },
      "forbidden_action_types": [
        "revert_commit",
        "scale"
      ],
      "id": "checkout_db_connection_errors",
      "provenance": {
        "kind": "executable_reference_workload",
        "reference": "services/checkout-service/app.py (process_checkout); chaos_mode knob",
        "source": "meridian-shop reference workload"
      },
      "recovery_probe": {
        "name": "checkout_error_ratio",
        "operator": "lt",
        "query": "(sum(rate(http_errors_total{service=\"checkout-service\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{service=\"checkout-service\"}[5m])) or vector(0), 1)",
        "require_failure_observation": true,
        "required_consecutive_passes": 2,
        "threshold": 0.45,
        "unit": "error ratio"
      },
      "risk_class": "critical",
      "root_cause": {
        "keywords": [
          "database",
          "connection",
          "pool",
          "timeout",
          "refused",
          "exhausted"
        ],
        "service": "checkout-service"
      },
      "taxonomy": {
        "category": "infrastructure",
        "fault_mode": "db_connectivity"
      },
      "version": "1.0.0"
    },
    {
      "alert": {
        "alertname": "CheckoutHighLatency",
        "description": "Latency spike. Slow downstream service or database contention.",
        "service": "checkout-service",
        "severity": "warning",
        "summary": "P95 latency 2.9s on checkout-service, breaching the 1.5s rule"
      },
      "allowed_action_types": [
