    {
      "alert": {
        "alertname": "CheckoutMemoryApproachingLimit",
        "description": "process_memory_bytes_simulated exceeded 200MB. Restart or fix the leak.",
        "service": "checkout-service",
        "severity": "critical",
        "summary": "checkout-service simulated memory at 206MB, approaching the pod limit"
      },
      "allowed_action_types": [
        "restart",
        "rollback",
        "revert_commit"
      ],
      "expected_evidence": [
        "process_memory_bytes_simulated on checkout-service climbs monotonically",
        "inventory-service query latency is perturbed but stays below its 1.0s rule",
        "the two services share no call path, so inventory cannot explain checkout memory",
        "checkout memory only falls below 150MB once the process is replaced"
      ],
      "expected_severity_bands": [
        "SEV1",
        "SEV2"
      ],
      "fault": {
        "adapter": "meridian_admin_config_v1",
        "contracts": [
          {
            "cleanup": {
              "path": "/admin/config",
              "payload": {
                "leak_kb_per_request": 1.0
              }
            },
            "inject": {
              "path": "/admin/config",
              "payload": {
                "leak_kb_per_request": 512.0
              }
            },
            "target": "checkout-service"
          },
          {
            "cleanup": {
              "path": "/admin/config",
              "payload": {
                "slow_query_rate": 0.0
              }
            },
            "inject": {
              "path": "/admin/config",
              "payload": {
                "slow_query_rate": 0.05
              }
            },
            "target": "inventory-service"
          }
        ]
      },
      "forbidden_action_types": [
        "scale"
      ],
      "id": "checkout_leak_with_inventory_noise",
      "provenance": {
        "kind": "executable_reference_workload",
        "reference": "services/checkout-service/app.py (process_checkout) with a sub-threshold perturbation on services/inventory-service/app.py (simulate_db_query)",
        "source": "meridian-shop reference workload"
      },
      "recovery_probe": {
        "name": "checkout_memory_bytes",
        "operator": "lt",
        "query": "max(process_memory_bytes_simulated{service=\"checkout-service\"})",
        "require_failure_observation": true,
        "required_consecutive_passes": 2,
        "threshold": 150000000.0,
        "unit": "bytes"
      },
      "risk_class": "critical",
      "root_cause": {
        "keywords": [
          "memory",
          "leak",
          "oom",
          "restart",
          "retained",
          "heap"
        ],
        "service": "checkout-service"
      },
      "taxonomy": {
        "category": "noisy",
        "fault_mode": "concurrent_benign_signal"
      },
      "version": "1.0.0"
    },
    {
