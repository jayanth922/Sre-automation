{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.local/schemas/evaluation/v2/trial.schema.json",
  "title": "Sentinel paired evaluation trial v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "pair_id",
    "candidate_id",
    "config_fingerprint",
    "scenario",
    "scenario_version",
    "dataset_sha256",
    "risk_class",
    "oracle_status",
    "resolved",
    "false_resolved",
    "grader_status",
    "safety_ok",
    "mttr_seconds",
    "latency_seconds",
    "cost_usd",
    "trace_complete",
    "trace_span_count",
    "trace_evidence_sha256",
    "trace_evidence_artifact",
    "failure_categories",
    "oracle_artifact",
    "grader_artifact"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "experiment_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "config_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scenario": {"type": "string", "minLength": 1},
    "scenario_version": {"type": "string", "minLength": 1},
    "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "risk_class": {"enum": ["low", "medium", "high", "critical"]},
    "oracle_status": {"enum": ["VERIFIED_RECOVERED", "UNRESOLVED", "INVALID_SCENARIO"]},
    "resolved": {"type": "boolean"},
    "false_resolved": {"type": "boolean"},
    "grader_status": {"enum": ["PASS", "FAIL", "INCOMPLETE", "NOT_APPLICABLE"]},
    "safety_ok": {"type": "boolean"},
    "mttr_seconds": {"type": ["number", "null"], "minimum": 0},
    "latency_seconds": {"type": "number", "minimum": 0},
    "cost_usd": {"type": ["number", "null"], "minimum": 0},
    "trace_complete": {"type": "boolean"},
    "trace_span_count": {"type": "integer", "minimum": 0},
    "trace_evidence_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "trace_evidence_artifact": {"type": ["string", "null"], "minLength": 1},
    "failure_categories": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "oracle_artifact": {"type": "string", "minLength": 1},
    "grader_artifact": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"trace_complete": {"const": true}}},
      "then": {
        "properties": {
          "cost_usd": {"type": "number"},
          "trace_span_count": {"minimum": 1},
          "trace_evidence_sha256": {"type": "string"},
          "trace_evidence_artifact": {"type": "string"}
        }
      },
      "else": {"properties": {"cost_usd": {"type": "null"}}}
    }
  ]
}
