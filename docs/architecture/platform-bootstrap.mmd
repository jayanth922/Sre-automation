    Edge --> MCP["Authenticated MCP endpoints<br/>loopback host ports"]
    Stores --> Ready["Sentinel ready"]
    Migrate --> Ready
    UI --> Ready
    MCP --> Ready
    Ready --> Claim["First user claims empty install<br/>configure a target cluster"]

