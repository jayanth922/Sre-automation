flowchart TD
    Open["Incident opened"] --> Claim["Durable worker claims leased job"]
    Claim --> State["Load checkpoint and incident state"]
    State --> Read["Bounded evidence collection"]
    Read --> Synthesis["Reflection + structured diagnosis"]
    Synthesis --> Decision{"Remediation outcome"}
    Decision -->|no safe action| Investigated["Investigated / unresolved"]
    Decision -->|approval required| Approval["Persist gate and pause"]
    Approval -->|approved| Execute["Authorize and execute once"]
    Approval -->|denied / expired| Investigated
    Decision -->|autonomous and allowed| Execute
    Execute --> Verify["Deterministic verification"]
    Verify -->|recovered| Ack["Pending acknowledgment"]
    Verify -->|failed / unknown| Failed["Failed or verification unknown"]
    Ack -->|acknowledged| Resolved["Resolved"]
    Investigated --> Timeline["Timeline + audit + manifest"]
    Failed --> Timeline
    Resolved --> Timeline

    style Approval fill:#fff3e0
    style Execute fill:#ffebee
    style Resolved fill:#e8f5e9
