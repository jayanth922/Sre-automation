flowchart TD
    Visit["Visit console"] --> Cookie{"Refresh cookie present?"}
    Cookie -->|No| Empty{"Installation has users?"}
    Empty -->|No| Claim["First-run claim"]
    Empty -->|Yes| Login["Login"]
    Cookie -->|Yes| Refresh["POST /auth/refresh"]
    Claim --> Session["Issue access token in memory<br/>set rotating httpOnly refresh cookie"]
    Login --> Session
    Refresh --> Session
    Session --> API["Authenticated API request"]
    API --> Scope["Derive user and organization<br/>server-side"]
    Scope --> UI["Render tenant-scoped console"]
    Refresh -->|invalid / reused| Revoke["Revoke token family<br/>clear cookie"]
    Revoke --> Login
    UI --> Logout["POST /auth/logout"]
    Logout --> Revoke

    style Session fill:#e8f5e9
    style Scope fill:#f3e5f5
    style Revoke fill:#ffebee
