flowchart TD
    Input["Alert or operator request"] --> Job["Persist tenant-scoped durable job"]
    Job --> Context["Build incident context<br/>namespace · runbook brief · limits"]
    Context --> Specialists["Bounded specialist agents<br/>metrics · logs · Kubernetes · code · runbooks"]
    Specialists --> Reflect["Reflect on structured evidence"]
    Reflect --> More{"One focused<br/>reinvestigation needed?"}
    More -->|Yes| Specialists
    More -->|No| Plan["Structured diagnosis and action plan"]
    Plan --> Gate["Deterministic policy / approval gate"]
    Gate -->|blocked or diagnosis only| Persist["Persist status, evidence, timeline, audit"]
    Gate -->|authorized| Mutation["Mutation gateway<br/>freshness · tenant · lock · idempotency"]
    Mutation --> Verify["Execute once and verify deterministically"]
    Verify --> Persist
    Persist --> Surface["Console + optional Slack thread"]

    style Specialists fill:#fff3e0
    style Gate fill:#f3e5f5
    style Mutation fill:#ffebee
    style Persist fill:#e8f5e9
