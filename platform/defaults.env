# Shipped defaults so the platform boots with no configuration at all.
#
# Every service lists this file first and the repo-root `../.env` second.
# Compose applies env_file entries in order with later ones winning, so
# anything you put in `../.env` overrides what is here — and `../.env` is
# optional, which is what makes `docker compose up -d --build` work on a
# fresh clone.
#
# What is deliberately NOT here: secrets. No API keys, no tokens, no
# passwords beyond the local-only Postgres bootstrap below. Provider keys,
# Slack, Notion, Jira, GitHub and per-cluster endpoints are configured in the
# dashboard's Settings and stored encrypted; SECRET_KEY, the credential
# encryption key and the MCP service token are generated on first boot into
# the `sentinel_keys` volume (see sre_agent/bootstrap_secrets.py).
#
# One caveat on the Postgres values: docker-compose.yaml also interpolates
# them into DATABASE_URL, and compose interpolation reads the shell
# environment and `platform/.env` — never this file or `../.env`. So if you
# change the Postgres user/password/db, export them or set them in
# `platform/.env` as well, or the URL the app dials and the database the
# container creates will disagree. (This is pre-existing behaviour; the only
# change is that they now have defaults instead of resolving to empty.)

# --- Local datastore bootstrap -------------------------------------------
# Reachable only on the internal compose network; not published to the host.
POSTGRES_USER=sre_user
POSTGRES_PASSWORD=sre_password
POSTGRES_DB=sre_platform

# --- Generated-secret keystore -------------------------------------------
# Backed by the `sentinel_keys` volume. Back it up with the database: without
# it, credentials saved through Settings cannot be decrypted.
SENTINEL_SECRET_STORE=/var/lib/sentinel/secrets.json

# --- Models ---------------------------------------------------------------
# No key here on purpose. Set the real one per cluster in Settings, where it
# is encrypted at rest; ANTHROPIC_API_KEY in `../.env` still works as a
# platform-wide fallback for single-tenant installs.
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-5
MODEL_ROUTER_BACKEND=litellm

# --- Edge MCP tool links --------------------------------------------------
# Container names on the shared-edge-network, not host ports.
MCP_K8S_URI=http://mcp-k8s:3000/sse
MCP_METRICS_URI=http://mcp-prometheus:3000/sse
MCP_LOGS_URI=http://mcp-loki:3000/sse
MCP_GITHUB_URI=http://mcp-github:3000/sse
MCP_RUNBOOKS_URI=http://mcp-runbooks:3000/sse
MCP_EXECUTOR_URI=http://mcp-executor:3000/sse
MCP_GITHUB_EXEC_URI=http://mcp-github-exec:3000/sse
MCP_SANDBOX_URI=http://mcp-sandbox:3000/sse

# --- Remediation policy ---------------------------------------------------
# Read-only advisor until an operator turns remediation on. Unknown
# environment values fail closed to production.
SENTINEL_CLUSTER_ENVIRONMENT=production
ACT_PHASE_ENABLED=false
APPROVAL_TTL_MINUTES=30

# --- Durability and streaming --------------------------------------------
CHECKPOINTER_ENABLED=false
CHECKPOINTER_BACKEND=memory
LIVE_BUS_BACKEND=memory
ALERT_RESOLUTION_RECONCILE_CONFIRM_SECONDS=300
ALERT_RESOLUTION_RECONCILE_TIMEOUT_SECONDS=8

# --- Single-tenant observability fallback ---------------------------------
# Multi-tenant installs read prometheus_url/loki_url per cluster from
# Settings; these only back the edge_mcp_servers/*_real fallback path.
PROMETHEUS_URL=http://host.docker.internal:9090
LOKI_URL=http://host.docker.internal:3100
RELAY_K8S_VERIFY_SSL=true

# --- Tracing --------------------------------------------------------------
# Per-organisation Langfuse keys live in Settings. With none set anywhere,
# investigations simply run untraced.
LANGFUSE_TRACING=true
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Code-fix verification workflow ---------------------------------------
TEMPORAL_ENABLED=false
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

DEBUG=false
