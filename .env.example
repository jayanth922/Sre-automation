# =============================================================================
# SRE SaaS Platform Config
# =============================================================================

# --- Core Security ---
SECRET_KEY="sre_platform_dev_key_change_in_production"
# Generate with:
# python -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
CREDENTIAL_ENCRYPTION_KEY=""
CREDENTIAL_ENCRYPTION_KEY_VERSION="1"
# JSON map of historical version -> key during rotation, e.g. {"1":"..."}
CREDENTIAL_ENCRYPTION_KEYS=""
# Must exactly match edge_mcp_servers/.env MCP_SERVICE_TOKEN.
MCP_SERVICE_TOKEN=""

# --- Models ---
# Supported LLM_PROVIDER values (must match the API allow-list exactly):
#   anthropic | gemini
# Unsupported values (groq, ollama, nvidia, openai_compatible, …) fail startup.
LLM_PROVIDER="anthropic"

# Anthropic (when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY="YOUR_KEY"
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

# Gemini (when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# Model router backend: route every LLM call through LiteLLM (sre_agent/model_
# router.py + litellm_backend.py) instead of calling the provider SDK directly.
# LiteLLM derives its model string from whichever provider/model is already
# configured above (per cluster, from the dashboard's Settings, or the
# LLM_PROVIDER/*_MODEL vars here) — no separate LiteLLM-specific config
# needed. Set MODEL_ROUTER_BACKEND="" to use the provider SDK path directly
# instead. Falls back automatically if litellm/langchain-litellm can't build
# the call, so this is safe to leave on.
MODEL_ROUTER_BACKEND="litellm"

# --- Database ---
POSTGRES_USER="sre_user"
POSTGRES_PASSWORD="sre_password"
POSTGRES_DB="sre_platform"

# --- Edge MCP Tool Links (SaaS -> Edge Bridges) ---
MCP_K8S_URI="http://host.docker.internal:4000/sse"
MCP_METRICS_URI="http://host.docker.internal:4001/sse"
MCP_LOGS_URI="http://host.docker.internal:4002/sse"
MCP_GITHUB_URI="http://host.docker.internal:4003/sse"
MCP_RUNBOOKS_URI="http://host.docker.internal:4004/sse"
# Executor (WRITE) tools — the ACT phase's hands. Only consumed when ACT_PHASE_ENABLED=true.
MCP_EXECUTOR_URI="http://host.docker.internal:4005/sse"
# GitHub-exec (WRITE) tools — code-change remediation (revert PRs).
MCP_GITHUB_EXEC_URI="http://host.docker.internal:4006/sse"

# --- ACT phase (autonomous remediation) ---
# Trusted operator policy environment; unknown values fail closed to production.
SENTINEL_CLUSTER_ENVIRONMENT="production"
# Off by default: the system stays a read-only advisor. Set true to enable
# severity-gated remediation (dry-run at the edge unless EXECUTOR live path is on).
ACT_PHASE_ENABLED="false"

# --- Durability / checkpointing (resume long investigations after a crash) ---
# Off by default (no behavior change). When true, graph state is persisted per
# incident so a restarted process resumes from the last checkpoint.
CHECKPOINTER_ENABLED="false"
# memory (in-process) | redis | postgres (external = true cross-crash durability).
# redis/postgres need langgraph-checkpoint-redis / -postgres installed.
CHECKPOINTER_BACKEND="memory"
# Pending remediation authorizations expire and cannot be replayed.
APPROVAL_TTL_MINUTES="30"

# --- Live streaming (WebSocket push) ---
# Event bus for the live incident/insight streams. memory (single process) or
# redis (multi-replica; uses REDIS_URL). Dashboard connects to /ws/incidents/{id}.
LIVE_BUS_BACKEND="memory"

# --- Observability Endpoints (For Dashboard Proxy) ---
PROMETHEUS_URL="http://host.docker.internal:9090"
LOKI_URL="http://host.docker.internal:3100"

# --- Directly Connected Target Systems (If not using Edge Relay) ---
K8S_API_SERVER=""
K8S_TOKEN=""

# --- Multi-tenant secure access (Phase 4) ---
# GitHub App: replaces long-lived Cluster.github_token PATs with short-lived
# (~1h) per-installation tokens. Leave blank to keep using stored PATs only.
GITHUB_APP_ID=""
# Either the raw PEM (multi-line values need quoting) or a path to the .pem file.
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_PRIVATE_KEY_PATH=""
# The App's URL slug, e.g. "sentinel-sre" for github.com/apps/sentinel-sre.
GITHUB_APP_SLUG=""

# Slack OAuth ("Add to Slack"): replaces the single global SLACK_BOT_TOKEN
# with a per-organization installed bot token (Organization.slack_bot_token).
# A self-hosted deployment that never runs this flow keeps using SLACK_BOT_TOKEN.
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
# Optional: overrides the default bot-token scope list (see slack_oauth.py).
SLACK_OAUTH_SCOPES=""

# Edge relay (k8s_real): set true only for a relayed cluster with a self-signed
# API server certificate in a trusted network — verify by default otherwise.
RELAY_K8S_VERIFY_SSL="true"

# --- Cluster Auto-Seed ---
# Leave blank for local demos that call start.sh / register flows which mint
# credentials at runtime. Never commit real passwords or cluster tokens.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_ORG="SRE Admin Org"
SEED_CLUSTER_TOKEN=""
SEED_CLUSTER_NAME="SRE Demo Cluster"
SEED_CLUSTER_STATUS="online"
CLUSTER_TOKEN=""

DEBUG="false"

# --- Incident memory (Qdrant, self-hosted) ---
# QDRANT_URL defaults to http://localhost:6333; platform/docker-compose.yaml overrides it
# to http://qdrant:6333 for the sre-agent-api container. Both tuning vars below are optional
# and only affect sre_agent/memory_store.py's ranking/embedding — safe to leave unset.
# SENTINEL_EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
# SENTINEL_MEMORY_RECENCY_HALF_LIFE_DAYS="30"

# --- Observability (Langfuse, self-hosted) ---
# Wired by default (sre_agent/tracing.py::langfuse_enabled()) — platform/docker-compose.yaml
# runs a full self-hosted Langfuse stack (web+worker+clickhouse+minio) and mints a matching
# API keypair automatically via LANGFUSE_INIT_* below, so a fresh `docker compose up` traces
# every LLM/tool call with zero manual setup. Set LANGFUSE_TRACING=false to opt out.
LANGFUSE_TRACING="true"
LANGFUSE_HOST="http://langfuse-web:3000"
# Dev-only shared keypair — fine to commit for local self-hosted use (not internet-facing,
# both sides read from this same file). Real deployments (Helm) must set their own via
# secrets.langfusePublicKey/langfuseSecretKey, which fail closed on this placeholder pair.
LANGFUSE_PUBLIC_KEY="pk-lf-sentinel-dev-0000000000000000"
LANGFUSE_SECRET_KEY="sk-lf-sentinel-dev-0000000000000000"
# Headless bootstrap for the langfuse-web container (see platform/docker-compose.yaml) —
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY/_SECRET_KEY must match the pair above exactly.
LANGFUSE_INIT_ORG_ID="sentinel"
LANGFUSE_INIT_ORG_NAME="Sentinel"
LANGFUSE_INIT_PROJECT_ID="sentinel-agent"
LANGFUSE_INIT_PROJECT_NAME="Sentinel Agent"
LANGFUSE_INIT_PROJECT_PUBLIC_KEY="pk-lf-sentinel-dev-0000000000000000"
LANGFUSE_INIT_PROJECT_SECRET_KEY="sk-lf-sentinel-dev-0000000000000000"
LANGFUSE_INIT_USER_EMAIL="admin@sentinel.local"
LANGFUSE_INIT_USER_NAME="Sentinel Admin"
LANGFUSE_INIT_USER_PASSWORD="change-me-langfuse-admin-password"
# Langfuse's own at-rest crypto — required, left blank so a real deployment must set
# them (same convention as CREDENTIAL_ENCRYPTION_KEY above); Langfuse won't boot without one.
# Generate with:
# python -c 'import secrets; print(secrets.token_hex(32))'   # LANGFUSE_ENCRYPTION_KEY (64 hex chars)
# python -c 'import secrets; print(secrets.token_urlsafe(32))'  # LANGFUSE_SALT
LANGFUSE_SALT=""
LANGFUSE_ENCRYPTION_KEY=""

LANGCHAIN_TRACING_V2="false"
LANGCHAIN_PROJECT="sre-agent"
LANGCHAIN_API_KEY="YOUR_KEY"
