# =============================================================================
# SRE Edge Relay — Customer Configuration
# =============================================================================
# Copy this to .env and fill in your values:  cp .env.example .env

# --- 1. Your Monitoring Stack ---
# Point these at your existing Prometheus and Loki instances
PROMETHEUS_URL=http://host.docker.internal:9090
LOKI_URL=http://host.docker.internal:3100

# --- 2. Your GitHub (for code context & revert PRs) ---
GITHUB_TOKEN=ghp_...
# High-entropy shared bearer token; must match the platform .env value.
MCP_SERVICE_TOKEN=
GITHUB_REPO=your-org/your-repo

# --- 3. Runbooks (Notion) ---
# Static single-tenant fallback for the runbooks MCP server. Leave blank for a
# self-hosted deployment with no Notion runbook database — lookup/generation
# just skips. SaaS clusters relay their own per-cluster Notion creds instead
# (set in the dashboard under a cluster's Settings, not here).
NOTION_API_KEY=
NOTION_DATABASE_ID=
